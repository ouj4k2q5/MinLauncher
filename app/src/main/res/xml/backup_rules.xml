<?xml version="1.0" encoding="utf-8"?>
<!-- Backup is fully disabled: MinLauncher promises its data never leaves the
    device, so every domain is excluded. These rules apply to Android 11
    (API 30) and older; API 31 and newer use data_extraction_rules.xml. -->
<full-backup-content>
    <exclude domain="root" path="."/>
    <exclude domain="file" path="."/>
    <exclude domain="database" path="."/>
    <exclude domain="sharedpref" path="."/>
    <exclude domain="external" path="."/>
</full-backup-content>
