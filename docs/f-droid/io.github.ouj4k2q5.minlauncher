License: GPL-3.0-only

SourceCode: https://github.com/ouj4k2q5/Minlauncher
IssueTracker: https://github.com/ouj4k2q5/Minlauncher/issues
Changelog: https://github.com/ouj4k2q5/Minlauncher/releases

RepoType: git
Repo: https://github.com/ouj4k2q5/Minlauncher.git

Builds:
 - versionName: 0.0.1
   versionCode: 1
   commit: b9bf0dfb9527bb3b7a95bc4c307e5abc6c684ccd
   gradle:
     - yes
   # UNVERIFIED: app/build.gradle reads versionName/versionCode from Gradle
   # properties (see release.yml), which F-Droid's build step won't pass on
   # its own. This prebuild line must be confirmed against a real `fdroid
   # build` run before submitting.
   prebuild: echo "appVersionName=0.0.1" >> gradle.properties && echo "appVersionCode=1" >> gradle.properties

AutoUpdateMode: Version
UpdateCheckMode: Tags
CurrentVersion: 0.0.1
CurrentVersionCode: 1
