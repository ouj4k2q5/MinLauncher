# EditorConfig: https://editorconfig.org
# ktlint reads this file for its code-style configuration (properties under
# [*.{kt,kts}] sections); anything not set here falls back to ktlint defaults,
# which follow the official Kotlin coding conventions.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space

[*.{kt,kts}]
indent_size = 4
max_line_length = 120
# Compose composables are PascalCase by convention (official Compose API style
# guidelines), e.g. MinLauncherTheme. This is ktlint's sanctioned option for
# the function-naming rule rather than a suppression or a renamed entry point.
ktlint_function_naming_ignore_when_annotated_with = Composable

[*.{gradle,properties,md}]
indent_size = 4

# All YAML in this repository (.github/, config/detekt/) is 2-space indented;
# a 4-space setting here made editors re-indent workflows incorrectly.
[*.{yml,yaml}]
indent_size = 2
